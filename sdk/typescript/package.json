{
  "name": "@model5/mycep-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Cliente oficial da API MyCEP — consulta de CEP e endereços do Brasil, autocomplete, geocoding reverso e validadores.",
  "keywords": [
    "cep",
    "correios",
    "endereco",
    "address",
    "brasil",
    "brazil",
    "api",
    "geocoding",
    "ibge",
    "viacep"
  ],
  "homepage": "https://www.mycep.app.br",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Model5Sistemas/mycep-examples-sdks.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/Model5Sistemas/mycep-examples-sdks/issues"
  },
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./validators": {
      "types": "./dist/validators.d.ts",
      "import": "./dist/validators.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
